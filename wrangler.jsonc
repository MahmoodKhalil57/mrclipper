{
  // Used only to bundle the Director (`wrangler deploy --dry-run`, run with Bun); the server runs it on workerd.
  "name": "mrclipper-director",
  "main": "src/worker/director.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "class_name": "Director", "name": "Director" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Director"], "tag": "v1" }]
}
