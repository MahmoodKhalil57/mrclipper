# Optional. Copy to .env to change a setting; the environment wins over this file.
# Nothing here is needed to run: the OpenRouter key is added in the app (🔑 Key in the top bar).

# Headless use only: the key the server uses when no browser has given it one.
# OPENROUTER_KEY=sk-or-...

# Where things go. Relative paths are relative to this folder.
# MRCLIPPER_WORKSPACE=../my-clips      # wins over the folder chosen in the app
# MRCLIPPER_STORE=.store               # holds workspace/, state/ and tools/ unless set below
# MRCLIPPER_DATA=.store/state
# MRCLIPPER_TOOLS=.store/tools

# Ports
# MRCLIPPER_PORT=4477
# MRCLIPPER_WORKER_PORT=8799

# Models (OpenRouter ids). Keep them cheap.
# DIRECTOR_MODEL=z-ai/glm-5.3-flash
# PLAN_MODELS=z-ai/glm-5.3-flash
# PLAN_REASONING=low
# TRANSCRIBE_MODEL=google/gemini-2.5-flash
# TIMING_MODEL=openai/whisper-large-v3
# VISION_MODEL=google/gemini-2.5-flash-lite
# JEV_MODEL=~typesafe/jev-latest

# Skip `bun run setup` when running `bun dev` (offline, or tools managed elsewhere).
# MRCLIPPER_SKIP_SETUP=1
# Run the Director with `wrangler dev` instead of workerd directly.
# MRCLIPPER_WRANGLER=1
